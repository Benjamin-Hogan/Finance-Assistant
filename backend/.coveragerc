[run]
source = src
omit = 
    */__pycache__/*
    */tests/*
    */.venv/*
    */venv/*
    */env/*
    */htmlcov/*
    */data/*
    */frontend/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError
    except ImportError

[html]
directory = htmlcov 